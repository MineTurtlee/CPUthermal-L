		<dict><key>cell</key><string>PSGroupCell</string><key>label</key><string>Thermal-Release High-Frequency Target</string><key>footerText</key><string>Only shown in "Thermal Release" mode. System needlessly throttles after thermal events; this keeps a high-speed target when possible.</string></dict>
