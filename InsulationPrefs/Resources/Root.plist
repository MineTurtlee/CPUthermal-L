	<key>items</key>
	<array>
		<dict><key>cell</key><string>PSGroupCell</string><key>label</key><string>Main Switch</string><key>footerText</key><string>iOS 18 dual-process design: thermalmonitord handles CPU/power limits, SpringBoard handles UI; default profile is low-power safe.</string></dict>
