<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>title</key><string>CPUthermal-L</string>
	<key>items</key>
	<array>
		<dict><key>cell</key><string>PSGroupCell</string><key>label</key><string>Main Switch</string><key>footerText</key><string>iOS 18 dual-process design: thermalmonitord handles CPU/power limits, SpringBoard handles display thermal dimming.</string></dict>
		<dict><key>cell</key><string>PSSwitchCell</string><key>key</key><string>enabled</string><key>default</key><true/><key>label</key><string>Enable CPUthermal-L</string></dict>
		<dict><key>cell</key><string>PSGroupCell</string><key>label</key><string>Operating Mode</string><key>footerText</key><string>Low Power actively enables Power Save and limits performance tier; Thermal Release disables throttling and raises CPU targets.</string></dict>
		<dict><key>cell</key><string>PSSegmentCell</string><key>key</key><string>powerMode</string><key>default</key><string>fullPower</string><key>label</key><string>Mode</string><key>validValues</key><array><string>fullPower</string><string>lowPower</string></array><key>titles</key><array><string>Thermal Release</string><string>Low Power</string></array></dict>
		<dict><key>cell</key><string>PSGroupCell</string><key>label</key><string>Thermal-Release High-Frequency Target</string><key>footerText</key><string>Only shown in "Thermal Release" mode. System nominal baseline is used to clamp high-frequency targets.</string></dict>
		<dict><key>cell</key><string>PSSegmentCell</string><key>key</key><string>fullPowerTargetPercent</string><key>default</key><integer>100</integer><key>label</key><string>High-Frequency Target</string><key>validValues</key><array><string>75</string><string>90</string><string>100</string></array><key>titles</key><array><string>75%</string><string>90%</string><string>100%</string></array></dict>
		<dict><key>cell</key><string>PSSwitchCell</string><key>key</key><string>preventThermalDimming</string><key>default</key><true/><key>label</key><string>Prevent Screen Dimming at High Temperature</string><key>respring</key><true/></dict>
		<dict><key>cell</key><string>PSSwitchCell</string><key>key</key><string>suppressThermalWarnings</string><key>default</key><false/><key>label</key><string>Hide High-Temperature Warning UI</string><key>respring</key><true/></dict>
		<dict><key>cell</key><string>PSGroupCell</string><key>label</key><string>Extreme Temperature Fallback</string><key>footerText</key><string>Disabled by default to avoid software fallback during 4K video playback. Enable to protect hardware in extreme situations.</string></dict>
		<dict><key>cell</key><string>PSSwitchCell</string><key>key</key><string>emergencyFallbackEnabled</string><key>default</key><false/><key>label</key><string>Enable Software Extreme-Temperature Fallback</string><key>respring</key><true/></dict>
		<dict><key>cell</key><string>PSSliderCell</string><key>key</key><string>emergencyTemperatureC</string><key>default</key><real>78</real><key>label</key><string>Fallback Threshold (°C)</string><key>min</key><real>65</real><key>max</key><real>95</real><key>isSegmented</key><true/><key>segmentCount</key><integer>7</integer></dict>
		<dict><key>cell</key><string>PSGroupCell</string><key>label</key><string>Application & Diagnostics</string><key>footerText</key><string>"Apply Immediately" usually requires no restart. Installing a new version or process crash may require respring or restart.</string></dict>
		<dict><key>cell</key><string>PSButtonCell</string><key>label</key><string>View Runtime Diagnostics</string><key>action</key><string>showDiagnostics</string></dict>
		<dict><key>cell</key><string>PSButtonCell</string><key>label</key><string>Apply Settings Immediately</string><key>action</key><string>applySettings</string></dict>
		<dict><key>cell</key><string>PSButtonCell</string><key>label</key><string>Restart thermalmonitord</string><key>action</key><string>restartThermalDaemon</string></dict>
		<dict><key>cell</key><string>PSButtonCell</string><key>label</key><string>Respring</string><key>action</key><string>respring</string></dict>
		<dict><key>cell</key><string>PSButtonCell</string><key>label</key><string>Restore Default Settings</string><key>action</key><string>resetSettings</string></dict>
		<dict><key>cell</key><string>PSGroupCell</string><key>label</key><string>Project</string></dict>
		<dict><key>cell</key><string>PSButtonCell</string><key>label</key><string>GitHub · riboly/CPUthermal-L</string><key>action</key><string>openSourceCode</string></dict>
		<dict><key>cell</key><string>PSGroupCell</string><key>label</key><string>Real-Time Monitoring</string><key>footerText</key><string>When this settings page is in the foreground, IOReport is read once per second to display real-time CPU frequency estimates.</string></dict>
		<dict><key>cell</key><string>PSStaticTextCell</string><key>cellClass</key><string>CTLMonitorCell</string><key>id</key><string>cpuMonitor</string><key>height</key><real>190</real><key>monitorText</key><string>P-core avg: -- MHz\nE-core avg: -- MHz\nTemperature: --°C\nEmergency: --\nHooks: --</string></dict>
	</array>
</dict>
</plist>
